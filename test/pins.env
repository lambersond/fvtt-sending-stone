# What the harness loads but doesn't hold, pinned by tag and SHA (sourced by dnd5e.sh and old-module.sh).
# dnd5e's from `git ls-remote https://github.com/foundryvtt/dnd5e`; the module's own from
# `git ls-remote --tags https://github.com/lambersond/fvtt-sending-stone`. To move a pin, change its tag
# and SHA together and run `npm run test:setup`, which refuses a checkout at any other SHA.
DND5E5_TAG=release-5.3.3
DND5E5_SHA=965ad2d0cf5d063dac675ba078b5bd3c3c0dd449
DND5E6_TAG=release-6.0.5
DND5E6_SHA=3ee48de02f8f6f7b2638c9f6cf3e9540c9c181cc
# Module 0.29.0 (groups.mjs compares a character's hash with it) and 0.30.0 (outcomes.mjs, chat data).
MODULE_029_SHA=9af8ebe0fffa5c8e8c85863a3dd12a751f476aa5
MODULE_030_SHA=6c70cb5d9b4b98ef1f3e385096a10dfea4b35977
