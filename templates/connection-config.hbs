<div class="sending-stone-connection">
    <p class="hint">{{localize "SENDINGSTONE.Connection.Hint"}}</p>

    <div class="form-group">
        <label for="sending-stone-destination">{{localize "SENDINGSTONE.Connection.Destination"}}</label>
        <div class="form-fields">
            <input type="text" id="sending-stone-destination" name="destination" value="{{destination}}"
                   placeholder="https://sending-stone.vercel.app" spellcheck="false" autocomplete="off"
                   inputmode="url" aria-describedby="sending-stone-endpoint">
        </div>
        <p class="hint">{{localize "SENDINGSTONE.Connection.DestinationHint"}}</p>
        <p class="hint sending-stone-endpoint" id="sending-stone-endpoint" data-endpoint>{{endpoint}}</p>
    </div>

    <div class="form-group">
        <label for="sending-stone-secret">{{localize "SENDINGSTONE.Connection.Secret"}}</label>
        <div class="form-fields">
            <input type="password" id="sending-stone-secret" name="secret" value="{{secret}}"
                   spellcheck="false" autocomplete="new-password">
        </div>
        <p class="hint">{{localize "SENDINGSTONE.Connection.SecretHint"}}</p>
    </div>

    <fieldset>
        <legend>{{localize "SENDINGSTONE.Connection.StatusLegend"}}</legend>
        <dl class="sending-stone-status">
            <dt>{{localize "SENDINGSTONE.Connection.Bridge"}}</dt>
            <dd>{{bridge}}</dd>
            <dt>{{localize "SENDINGSTONE.Connection.Deliveries"}}</dt>
            <dd data-delivery-status data-state="{{statusState}}">{{status}}</dd>
        </dl>
        <p class="sending-stone-test-result" data-test-result role="status" aria-live="polite"></p>
    </fieldset>
</div>
