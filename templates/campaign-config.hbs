<div class="sending-stone-campaigns-config">
    <p class="hint">{{localize "SENDINGSTONE.Campaigns.Hint"}}</p>

    <div class="form-group">
        <label for="sending-stone-destination">{{localize "SENDINGSTONE.Campaigns.Destination"}}</label>
        <div class="form-fields">
            <input type="text" id="sending-stone-destination" name="destination" value="{{destination}}"
                   placeholder="https://sending-stone.vercel.app" spellcheck="false" autocomplete="off"
                   inputmode="url">
        </div>
    </div>

    <div class="sending-stone-campaign-list">
        {{#each campaigns as |campaign|}}
        <fieldset class="sending-stone-campaign">
            <legend>{{campaign.legend}}</legend>
            <input type="hidden" name="campaigns.{{campaign.index}}.id" value="{{campaign.id}}">

            <div class="form-group">
                <label for="sending-stone-campaign-{{campaign.id}}">{{localize "SENDINGSTONE.Campaigns.CampaignTitle"}}</label>
                <div class="form-fields">
                    <input type="text" id="sending-stone-campaign-{{campaign.id}}"
                           name="campaigns.{{campaign.index}}.title" value="{{campaign.title}}" required
                           placeholder="{{localize "SENDINGSTONE.Campaigns.TitlePlaceholder"}}" autocomplete="off">
                    <button type="button" class="icon fa-solid fa-trash" data-action="removeCampaign"
                            data-index="{{campaign.index}}" data-tooltip="SENDINGSTONE.Campaigns.Remove"
                            aria-label="{{localize "SENDINGSTONE.Campaigns.Remove"}}"></button>
                </div>
            </div>

            <div class="form-group">
                <label for="sending-stone-secret-{{campaign.id}}">{{localize "SENDINGSTONE.Campaigns.Secret"}}</label>
                <div class="form-fields">
                    <input type="password" id="sending-stone-secret-{{campaign.id}}"
                           name="campaigns.{{campaign.index}}.secret" value="{{campaign.secret}}"
                           spellcheck="false" autocomplete="new-password">
                    <button type="button" class="sending-stone-test" data-action="testCampaign"
                            data-index="{{campaign.index}}">
                        <i class="fa-solid fa-satellite-dish" inert></i>
                        {{localize "SENDINGSTONE.Test.Test"}}
                    </button>
                </div>
            </div>
            <p class="sending-stone-test-result" data-test-result="{{campaign.index}}" role="status"
               aria-live="polite"></p>

            <div class="form-group">
                <label for="sending-stone-rolls-{{campaign.id}}">{{localize "SENDINGSTONE.Campaigns.Rolls"}}</label>
                <div class="form-fields">
                    <input type="checkbox" id="sending-stone-rolls-{{campaign.id}}"
                           name="campaigns.{{campaign.index}}.rolls" {{#if campaign.rolls}}checked{{/if}}>
                </div>
                <p class="hint">{{localize "SENDINGSTONE.Campaigns.RollsHint"}}</p>
                {{#if @root.rollsUnavailable}}
                <p class="hint sending-stone-warning">{{@root.rollsUnavailable}}</p>
                {{/if}}
            </div>

            <div class="form-group sending-stone-prompts">
                <label for="sending-stone-prompts-{{campaign.id}}">{{localize "SENDINGSTONE.Campaigns.Prompts"}}</label>
                <div class="form-fields">
                    <input type="checkbox" id="sending-stone-prompts-{{campaign.id}}"
                           name="campaigns.{{campaign.index}}.prompts" {{#if campaign.prompts}}checked{{/if}}>
                </div>
                <p class="hint">{{localize "SENDINGSTONE.Campaigns.PromptsHint"}}</p>
            </div>

            <div class="form-group sending-stone-attacks">
                <label for="sending-stone-attacks-{{campaign.id}}">{{localize "SENDINGSTONE.Campaigns.Attacks"}}</label>
                <div class="form-fields">
                    <input type="checkbox" id="sending-stone-attacks-{{campaign.id}}"
                           name="campaigns.{{campaign.index}}.attacks" {{#if campaign.attacks}}checked{{/if}}>
                </div>
                <p class="hint">{{localize "SENDINGSTONE.Campaigns.AttacksHint"}}</p>
                {{#if @root.attacksUnavailable}}
                <p class="hint sending-stone-warning">{{@root.attacksUnavailable}}</p>
                {{/if}}
            </div>

            {{#if @root.hasCharacters}}
            <table class="sending-stone-characters">
                <thead>
                    <tr>
                        <th scope="col">{{localize "SENDINGSTONE.Campaigns.InCampaign"}}</th>
                        <th scope="col">{{localize "SENDINGSTONE.Campaigns.Character"}}</th>
                        <th scope="col">{{localize "SENDINGSTONE.Campaigns.Owners"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each campaign.characters as |character|}}
                    <tr>
                        <td>
                            <input type="checkbox" name="campaigns.{{campaign.index}}.characters.{{character.id}}"
                                   id="sending-stone-{{campaign.id}}-{{character.id}}"
                                   {{#if character.checked}}checked{{/if}}>
                        </td>
                        <th scope="row">
                            <label for="sending-stone-{{campaign.id}}-{{character.id}}">
                                <img src="{{character.img}}" alt="">
                                <span>{{character.name}}</span>
                            </label>
                        </th>
                        <td>{{character.owners}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            {{else}}
            <p class="sending-stone-empty">{{localize "SENDINGSTONE.Campaigns.NoCharacters"}}</p>
            {{/if}}
        </fieldset>
        {{else}}
        <p class="sending-stone-empty">{{localize "SENDINGSTONE.Campaigns.None"}}</p>
        {{/each}}
    </div>
</div>
