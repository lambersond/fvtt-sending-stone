<header class="sending-stone-header sending-stone-header-ruled">
    <h2 tabindex="-1">{{localize "SENDINGSTONE.Config.General.Title"}}</h2>
    <p class="sending-stone-subtitle">{{localize "SENDINGSTONE.Config.General.Subtitle"}}</p>
</header>

<div class="sending-stone-scroll">
    <div class="form-group">
        <label for="sending-stone-destination">{{localize "SENDINGSTONE.Config.General.Address"}}</label>
        <div class="form-fields">
            <input type="text" id="sending-stone-destination" name="destination" value="{{general.destination}}"
                   placeholder="https://sending-stone.vercel.app" spellcheck="false" autocomplete="off"
                   inputmode="url">
        </div>
        <p class="hint">{{localize "SENDINGSTONE.Config.General.AddressHint"}}</p>
    </div>

    <fieldset>
        <legend>{{localize "SENDINGSTONE.Config.General.Send"}}</legend>
        <div class="form-group">
            <label for="sending-stone-chat">{{localize "SENDINGSTONE.Config.General.Chat"}}</label>
            <div class="form-fields">
                <input type="checkbox" id="sending-stone-chat" name="chatEvents" {{#if general.chatEvents}}checked{{/if}}>
            </div>
            <p class="hint">{{localize "SENDINGSTONE.Config.General.ChatHint"}}</p>
        </div>
        <div class="form-group sending-stone-nested {{#unless general.chatEvents}}disabled{{/unless}}">
            <label for="sending-stone-scope">{{localize "SENDINGSTONE.Config.General.Scope"}}</label>
            <div class="form-fields">
                <select id="sending-stone-scope" name="chatScope" {{#unless general.chatEvents}}disabled{{/unless}}>
                    {{#each general.scopes as |scope|}}
                    <option value="{{scope.value}}" {{#if scope.selected}}selected{{/if}}>{{scope.label}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        <div class="form-group sending-stone-nested {{#unless general.chatEvents}}disabled{{/unless}}">
            <label for="sending-stone-results">{{localize "SENDINGSTONE.Config.General.Results"}}</label>
            <div class="form-fields">
                <select id="sending-stone-results" name="chatResults" {{#unless general.chatEvents}}disabled{{/unless}}>
                    {{#each general.results as |choice|}}
                    <option value="{{choice.value}}" {{#if choice.selected}}selected{{/if}}>{{choice.label}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="hint">{{localize "SENDINGSTONE.Config.General.ResultsHint"}}</p>
        </div>
        <div class="form-group">
            <label for="sending-stone-combat">{{localize "SENDINGSTONE.Config.General.Combat"}}</label>
            <div class="form-fields">
                <input type="checkbox" id="sending-stone-combat" name="combatEvents" {{#if general.combatEvents}}checked{{/if}}>
            </div>
            <p class="hint">{{localize "SENDINGSTONE.Config.General.CombatHint"}}</p>
        </div>
        <div class="form-group">
            <label for="sending-stone-gm">{{localize "SENDINGSTONE.Config.General.GmContent"}}</label>
            <div class="form-fields">
                <input type="checkbox" id="sending-stone-gm" name="gmContent" {{#if general.gmContent}}checked{{/if}}>
            </div>
            <p class="hint">{{localize "SENDINGSTONE.Config.General.GmContentHint"}}</p>
        </div>
    </fieldset>

    {{#if general.midi}}
    <fieldset>
        <legend>{{localize "SENDINGSTONE.Config.General.Midi"}}</legend>
        <div class="form-group">
            <label for="sending-stone-midi">{{localize "SENDINGSTONE.Config.General.MidiIntegration"}}</label>
            <div class="form-fields">
                <input type="checkbox" id="sending-stone-midi" name="midiIntegration" {{#if general.midi.integration}}checked{{/if}}>
            </div>
            <p class="hint">{{localize "SENDINGSTONE.Config.General.MidiIntegrationHint"}}</p>
        </div>
        <div class="form-group sending-stone-nested {{#unless general.midi.integration}}disabled{{/unless}}">
            <label for="sending-stone-off-canvas">{{localize "SENDINGSTONE.Config.General.OffCanvas"}}</label>
            <div class="form-fields">
                <input type="checkbox" id="sending-stone-off-canvas" name="offCanvasTargets"
                       {{#if general.midi.offCanvas}}checked{{/if}} {{#unless general.midi.integration}}disabled{{/unless}}>
            </div>
            <p class="hint">{{localize "SENDINGSTONE.Config.General.OffCanvasHint"}}</p>
        </div>
    </fieldset>
    {{/if}}
</div>
