<div class="sending-stone-characters-config">
    <p class="hint">{{localize "SENDINGSTONE.Characters.Hint"}}</p>

    {{#if characters.length}}
    <div class="sending-stone-character-list">
        <table class="sending-stone-characters">
            <thead>
                <tr>
                    <th scope="col">{{localize "SENDINGSTONE.Characters.Connected"}}</th>
                    <th scope="col">{{localize "SENDINGSTONE.Characters.Character"}}</th>
                    <th scope="col">{{localize "SENDINGSTONE.Characters.Owners"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each characters as |character|}}
                <tr>
                    <td>
                        <input type="checkbox" name="{{character.id}}" id="sending-stone-character-{{character.id}}"
                               {{#if character.connected}}checked{{/if}}>
                    </td>
                    <th scope="row">
                        <label for="sending-stone-character-{{character.id}}">
                            <img src="{{character.img}}" alt="">
                            <span>{{character.name}}</span>
                        </label>
                    </th>
                    <td>{{character.owners}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <p class="sending-stone-empty">{{localize "SENDINGSTONE.Characters.None"}}</p>
    {{/if}}
</div>
